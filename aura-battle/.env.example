# Optional: URL of your own backend endpoint that proxies an LLM call for the
# AI Judge (Custom Aura / Aura Farming subjective scoring). If unset, the
# game uses a fully local, algorithmic fallback judge — it is playable
# without this.
#
# Your endpoint must accept POST { challengeId, prompt, features } and
# return JSON: { "score": number, "criteria": Record<string, number>, "comment"?: string }
VITE_AI_JUDGE_URL=

# Supabase browser client
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Supabase server key. Keep this server-only and never prefix it with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
